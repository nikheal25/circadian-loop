{
  "name": "circadian-loop",
  "version": "0.1.0",
  "description": "Circadian Loop for pi: the agent checkpoints to disk, sleeps on a countdown, then wakes into a fresh context and resumes from loop.md. Pure extension — no scripts, no patches.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "skill",
    "agent",
    "loop",
    "circadian",
    "long-running",
    "autonomous"
  ],
  "author": "nikheal25",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikheal25/circadian-loop.git"
  },
  "bugs": {
    "url": "https://github.com/nikheal25/circadian-loop/issues"
  },
  "homepage": "https://github.com/nikheal25/circadian-loop#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "audit:runtime": "npm audit --omit=dev --omit=peer"
  },
  "files": [
    ".pi/extensions/circadian-loop",
    ".pi/skills/circadian-loop",
    "assets/banner.png",
    "assets/how-it-works.png",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^26.1.2",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      ".pi/extensions/circadian-loop"
    ],
    "skills": [
      ".pi/skills/circadian-loop"
    ],
    "image": "https://raw.githubusercontent.com/nikheal25/circadian-loop/main/assets/banner.png"
  },
  "publishConfig": {
    "access": "public"
  }
}
